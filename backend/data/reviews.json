  },
  {
    "id": "ddcaabe7-db17-47fd-87a2-94fe565a2899",
    "game_id": "e6fe6e4c-b318-407e-b140-88d5bfca8939",
    "author": "Олег",
    "is_recommended": true,
    "hours_played": 41,
    "text": "Атмосфера просто неймовірна, музика теж.",
    "created_at": "2026-10-02T02:00:00.000Z"
  },
  {
    "id": "218a635f-4254-4c2d-b077-8cd1a341d9fa",
