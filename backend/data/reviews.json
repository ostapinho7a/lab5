    "author": "kriper",
    "is_recommended": true,
    "hours_played": 30,
    "text": "За такі гроші це шедевр.",
    "created_at": "2026-10-02T23:00:00.000Z"
  },
  {
    "id": "7b760933-4b9e-411c-b02f-b069fc165552",
    "game_id": "a4e05383-f45d-4d3f-a97f-6ce4757e756c",
    "author": "strawberry",
    "is_recommended": true,
    "hours_played": 19,
    "text": "Складно, але кожен рівень проходиш з радістю.",
    "created_at": "2026-10-03T06:00:00.000Z"
  },
  {
    "id": "fe6290c8-78f4-4b3c-ac81-9cbffc6d9af4",
    "game_id": "a4e05383-f45d-4d3f-a97f-6ce4757e756c",
    "author": "Андрій",
    "is_recommended": true,
    "hours_played": 12,
    "text": "Дуже гарна історія.",
