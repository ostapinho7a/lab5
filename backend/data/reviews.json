  },
  {
    "id": "cc912d5c-ee59-4f68-8fb2-bece6c2ba81b",
    "game_id": "a4e05383-f45d-4d3f-a97f-6ce4757e756c",
    "author": "casual_cat",
    "is_recommended": false,
    "hours_played": 3,
    "text": "Для мене занадто важко, кинув на третій главі.",
    "created_at": "2026-10-04T03:00:00.000Z"
  },
  {
    "id": "eab1dbd7-88bb-42db-9e9f-125bd50c1a2b",
